# Copy to .env and adjust as needed. docker-compose reads this automatically.
# Every variable here has a safe default; override only what you need.

# --- Postgres credentials (local dev only, Railway generates these) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Qdrant ---
# Set a token to require authentication on Qdrant. Leave empty for local dev.
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Embeddings ---
# auto picks OpenAI when OPENAI_API_KEY is set, fastembed otherwise.
# Force one with EMBED_ENGINE=fastembed or EMBED_ENGINE=openai.
EMBED_ENGINE=auto

# fastembed runs locally, no API key needed. This model ships inside the image.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# OpenAI. Setting the key is enough to switch engines.
OPENAI_API_KEY=
OPENAI_MODEL=text-embedding-3-large
OPENAI_DIMENSIONS=1024

# --- App ---
# Key required in the X-API-Key header. Empty leaves the API open.
API_KEY=
CORS_ORIGINS=http://localhost:3000
DEBUG=true
APP_NAME=Vector Knowledge Base API
LOG_LEVEL=info

# Set to true to start without running alembic migrations.
SKIP_MIGRATIONS=false
